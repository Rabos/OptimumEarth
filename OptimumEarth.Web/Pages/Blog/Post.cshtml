@page "/blog/{slug}"
@model OptimumEarth.Web.Pages.Blog.PostModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var p = Model.Post;
    ViewData["Theme"] = "blog";
    ViewData["Title"] = p.SeoTitle;
    ViewData["Description"] = p.SeoDescription;
    var siteUrl = (Configuration["SiteUrl"] ?? "https://optimum-earth.com").TrimEnd('/');
    if (!string.IsNullOrEmpty(p.CoverPath)) { ViewData["OgImage"] = p.CoverPath.StartsWith("http") ? p.CoverPath : siteUrl + p.CoverPath; }
}

<article class="blog-post">
    <header class="blog-post__head">
        <a class="blog-card__tag" href="/blog/category/@p.CategorySlug">@p.CategoryName</a>
        <h1 class="blog-post__title">@p.Title</h1>
        <p class="blog-post__meta">@p.Author · <time datetime="@p.Date.ToString("yyyy-MM-dd")">@p.Date.ToString("d MMMM yyyy")</time> · @p.ReadingMinutes min read</p>
    </header>

    @if (!string.IsNullOrEmpty(p.CoverPath))
    {
        <div class="blog-post__cover" role="img" aria-label="@p.Title" style="background-image: url('@p.CoverPath')"></div>
    }

    <div class="blog-prose">@Html.Raw(p.Html)</div>

    @if (p.Tags.Count > 0)
    {
        <ul class="blog-tags" aria-label="Tags">
            @foreach (var t in p.Tags) { <li>@t</li> }
        </ul>
    }

    <p><a class="text-link" href="/blog">&larr; All posts</a></p>
</article>
