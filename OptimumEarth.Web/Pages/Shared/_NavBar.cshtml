@{
    // Standalone partial so the header/nav markup can be reused (or, on the
    // home page, skipped entirely) without duplicating it in _Layout.
    var theme = ViewData["Theme"] as string ?? "home";

    string NavClass(string key, string? variant = null) =>
        "primary-nav__link" + (variant != null ? " primary-nav__link--" + variant : "") + (theme == key ? " is-current" : "");
}

<header class="site-header" data-site-header>
    <div class="shell site-header__row">
        <div class="brand-group">
            <a class="brand" href="/">
                <img class="brand__logo" src="~/img/logo.svg" alt="Optimum Earth" />
            </a>
            @if (theme == "foundation")
            {
                <a class="brand" href="/foundation">
                    <img class="brand__logo" src="~/img/logo.svg" alt="Optimum Earth Foundation" />
                </a>
            }
        </div>
        <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="primary-nav">
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="nav-toggle__bar"></span>
            <span class="visually-hidden">Menu</span>
        </button>

        <nav class="primary-nav" id="primary-nav" data-primary-nav aria-label="Primary" data-open="false">
            <div class="primary-nav__head">
                <a class="brand" href="/">
                    <img class="brand__logo" src="~/img/logo.svg" alt="Optimum Earth" />
                </a>
                <button type="button" class="primary-nav__close" data-nav-close aria-label="Close menu">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
            </div>
            <div class="primary-nav__destinations">
                <a href="/uganda" class="@NavClass("uganda", "uganda")">Uganda</a>
                <a href="/zambia" class="@NavClass("zambia", "zambia")">Zambia</a>
                <a href="/services" class="@NavClass("services")">Services</a>
                <a href="/projects" class="@NavClass("projects")">Projects</a>
            </div>
            <span class="primary-nav__divider" aria-hidden="true"></span>
            <a href="/foundation" class="btn btn--nav btn--nav-foundation-cta primary-nav__cta @NavClass("foundation", "foundation" )">Foundation</a>
            <a href="/contact" class="btn btn--nav btn--nav-cta primary-nav__cta">Work With Us</a>
        </nav>
    </div>
</header>
