@model OptimumEarth.Web.Models.DestinationPageViewModel

<div class="dest-hero">
    <div class="img-slot" role="img" aria-label="@Model.HeroImageLabel"></div>
    <div class="dest-hero__scrim" aria-hidden="true"></div>
    <div class="dest-hero__copy">
        <span class="dest-hero__eyebrow">@Model.HeroEyebrow</span>
        <h1 class="dest-hero__headline">@Model.HeroHeadline</h1>
        <p class="dest-hero__sub">@Model.HeroSub</p>
    </div>
</div>

<section class="dest-overview" aria-labelledby="overview-heading">
    <div class="dest-overview__main">
        <span class="dest-overview__eyebrow" id="overview-heading">@Model.OverviewEyebrow</span>
        <p class="dest-overview__quote">@Model.OverviewQuote</p>
        <p class="dest-overview__body">@Model.OverviewBody</p>
    </div>
    <aside class="glance-panel" aria-label="At a glance">
        <span class="glance-panel__title">At a glance</span>
        @foreach (var fact in Model.Facts)
        {
            <div class="glance-row">
                <span class="glance-row__key">@fact.Key</span>
                <span class="glance-row__value">@fact.Value</span>
            </div>
        }
    </aside>
</section>

<section class="dest-section dest-section--tint" aria-labelledby="section-one-heading">
    <div class="dest-section__head">
        <h2 id="section-one-heading">@Model.SectionOneTitle</h2>
        @if (!string.IsNullOrEmpty(Model.SectionOneLinkText))
        {
            <a class="text-link" href="@Model.SectionOneLinkHref">@Model.SectionOneLinkText &rarr;</a>
        }
    </div>
    <div class="plain-card-grid">
        @foreach (var card in Model.SectionOneCards)
        {
            @if (Model.UsePillarCards)
            {
                <article class="pillar-card">
                    <span class="pillar-card__index">@card.Index</span>
                    <h3 class="pillar-card__title">@card.Title</h3>
                    <p class="pillar-card__desc">@card.Description</p>
                </article>
            }
            else
            {
                <article class="service-card">
                    <h3 class="service-card__title">@card.Title</h3>
                    <p class="service-card__desc">@card.Description</p>
                </article>
            }
        }
    </div>
</section>

<section class="dest-section" aria-labelledby="section-two-heading">
    <div class="dest-section__head">
        <h2 id="section-two-heading">@Model.SectionTwoTitle</h2>
        @if (!string.IsNullOrEmpty(Model.SectionTwoLinkText))
        {
            <a class="text-link" href="@Model.SectionTwoLinkHref">@Model.SectionTwoLinkText &rarr;</a>
        }
    </div>
    <div class="card-grid card-grid--stories">
        @foreach (var tile in Model.SectionTwoCards)
        {
            <button type="button" class="story-tile" data-story-trigger="@tile.Country" aria-haspopup="dialog">
                <div class="story-tile__media img-slot" role="img" aria-label="@tile.ImageLabel" style="background-image: url('@tile.ImagePath')"></div>
                <div class="story-tile__body">
                    <h3 class="story-tile__title">@tile.Title</h3>
                    <p class="story-tile__meta">@tile.Meta</p>
                    @* the fuller text, revealed under the hover veil. The dialog this
                       button opens carries the same string, so it is aria-hidden here
                       rather than announced twice. *@
                    <p class="story-tile__full" aria-hidden="true">@tile.Description</p>
                    <span class="story-tile__cue">
                        @{
                            var projectDescription = Model.SectionTwoCardDescriptions.FirstOrDefault(d => d.ProjectSlug == tile.Slug);
                            if (projectDescription != null)
                            {
                                <p>@projectDescription.Description</p>
                            }
                        }
                        
                        @* Read more
                        <svg viewBox="0 0 20 9" fill="none" aria-hidden="true"><path d="M0 4.5h18M14 1l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg> *@
                    </span>
                </div>
            </button>

            
        }
    </div>
    
    @* <div class="card-grid">
        @foreach (var card in Model.SectionTwoCards)
        {
            <article class="project-card" style="background-image: linear-gradient(135deg, rgba(27, 42, 68, 0.6) 0%, rgba(27, 42, 68, 0.4) 100%), url('@card.ImagePath');">
                <div class="project-card__body">
                    <span class="project-card__tag">@card.Tag</span>
                    <h3 class="project-card__title">@card.Title</h3>
                    <p class="project-card__meta">@card.Meta</p>
                </div>
            </article>
        }
    </div> *@
    @if (!string.IsNullOrEmpty(Model.SectionTwoNote))
    {
        <p class="section-note">@Model.SectionTwoNote</p>
    }
</section>

<section class="dest-cta" aria-labelledby="cta-heading" id="contact">
    <div>
        <h2 class="dest-cta__title" id="cta-heading">@Model.CtaTitle</h2>
        <p class="dest-cta__body">@Model.CtaBody</p>
    </div>
    <div>
        @if (Model.Submitted)
        {
            <p class="form-success" role="status">Thank you - your enquiry is in. Our team will be in touch shortly.</p>
        }
        else
        {
            <form class="mini-form" method="post" asp-page-handler="Quick">
                <div asp-validation-summary="ModelOnly" class="visually-hidden" role="alert"></div>
                <input type="hidden" asp-for="Quick.Destination" />
                <div class="mini-form__row">
                    <div>
                        <label class="visually-hidden" asp-for="Quick.FullName">Full name</label>
                        <input asp-for="Quick.FullName" placeholder="Full name" autocomplete="name" />
                        <span asp-validation-for="Quick.FullName" class="field-error"></span>
                    </div>
                    <div>
                        <label class="visually-hidden" asp-for="Quick.Email">Email</label>
                        <input asp-for="Quick.Email" type="email" placeholder="Email" autocomplete="email" />
                        <span asp-validation-for="Quick.Email" class="field-error"></span>
                    </div>
                </div>
                <div>
                    <label class="visually-hidden" asp-for="Quick.Service">@Model.CtaServiceLabel</label>
                    <select asp-for="Quick.Service">
                        <option value="">@Model.CtaServiceLabel</option>
                        @foreach (var option in Model.CtaServiceOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span asp-validation-for="Quick.Service" class="field-error"></span>
                </div>
                <button type="submit" class="mini-form__submit">Send enquiry</button>
            </form>
        }
    </div>
</section>
