@using System.Text.Json
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var theme = ViewData["Theme"] as string ?? "home";
    var title = ViewData["Title"] as string ?? "Optimum Earth";
    var description = ViewData["Description"] as string ??
        "Optimum Earth delivers water, energy, environment, GIS and engineering solutions across East and Southern Africa, alongside the community-led work of the Optimum Earth Foundation.";
    var robots = ViewData["Robots"] as string ?? "index, follow";

    // Canonical/OG URLs are built from a configured production host rather
    // than the incoming request, so staging/dev hits never leak into
    // indexable metadata; only the path comes from the current request.
    var siteUrl = (Configuration["SiteUrl"] ?? "https://optimum-earth.com").TrimEnd('/');
    var path = Context.Request.Path.Value?.ToLowerInvariant().TrimEnd('/') ?? "";
    var canonicalUrl = siteUrl + (path.Length == 0 ? "/" : path);
    var ogImageUrl = siteUrl + "/img/og-image.png";
    var logoUrl = siteUrl + "/img/logo-icon.png";

    // Most page titles are already brand-qualified ("Optimum Earth Foundation
    // - ...", "Contact Us - Work With Optimum Earth"); only append the
    // " | Optimum Earth" suffix when the brand isn't already in there, so we
    // never end up with the name repeated two or three times in a <title>.
    var pageTitle = title.Contains("Optimum Earth", StringComparison.OrdinalIgnoreCase)
        ? title
        : title + " | Optimum Earth";

    string NavClass(string key, string? variant = null) =>
        "primary-nav__link" + (variant != null ? " primary-nav__link--" + variant : "") + (theme == key ? " is-current" : "");

    var breadcrumbNames = new Dictionary<string, string>
    {
        ["uganda"] = "Uganda",
        ["zambia"] = "Zambia",
        ["foundation"] = "Foundation",
        ["services"] = "Services",
        ["projects"] = "Projects",
        ["contact"] = "Contact",
    };

    var organizationJsonLd = JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = "Optimum Earth",
        ["url"] = siteUrl + "/",
        ["logo"] = logoUrl,
        ["description"] = "Optimum Earth delivers water, energy, environment, GIS and engineering solutions across East and Southern Africa, alongside the community-led work of the Optimum Earth Foundation.",
        ["address"] = new Dictionary<string, object>
        {
            ["@type"] = "PostalAddress",
            ["streetAddress"] = "Roston House, Plot 56/57",
            ["postOfficeBoxNumber"] = "P.O Box 200032",
            ["addressLocality"] = "Kampala",
            ["addressCountry"] = "UG",
        },
        ["contactPoint"] = new[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "ContactPoint",
                ["telephone"] = "+256-784-080551",
                ["contactType"] = "customer service",
                ["email"] = "uganda@optimum-earth.com",
                ["areaServed"] = new[] { "UG", "ZM" },
            },
        },
    });

    string? breadcrumbJsonLd = null;
    if (breadcrumbNames.TryGetValue(theme, out var crumbName))
    {
        breadcrumbJsonLd = JsonSerializer.Serialize(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = siteUrl + "/" },
                new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = crumbName, ["item"] = canonicalUrl },
            },
        });
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta name="theme-color" content="#214292" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Optimum Earth" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Optimum Earth" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImageUrl" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&amp;family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script type="application/ld+json">@Html.Raw(organizationJsonLd)</script>
    @if (breadcrumbJsonLd != null)
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbJsonLd)</script>
    }
</head>
<body class="theme-@theme">

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-site-header>
        <div class="shell site-header__row">
            <a class="brand" href="/">
                <img class="brand__logo" src="~/img/logo.svg" alt="Optimum Earth" />
            </a>

            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="primary-nav">
                <span class="nav-toggle__bar"></span>
                <span class="nav-toggle__bar"></span>
                <span class="nav-toggle__bar"></span>
                <span class="visually-hidden">Menu</span>
            </button>

            <nav class="primary-nav" id="primary-nav" data-primary-nav aria-label="Primary" data-open="false">
                <div class="primary-nav__head">
                    <a class="brand" href="/">
                        <img class="brand__logo" src="~/img/logo.svg" alt="Optimum Earth" />
                    </a>
                    <button type="button" class="primary-nav__close" data-nav-close aria-label="Close menu">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    </button>
                </div>
                <div class="primary-nav__destinations">
                    <a href="/uganda" class="@NavClass("uganda", "uganda")">Uganda</a>
                    <a href="/zambia" class="@NavClass("zambia", "zambia")">Zambia</a>
                    <a href="/foundation" class="@NavClass("foundation", "foundation")">Foundation</a>
                </div>
                <span class="primary-nav__divider" aria-hidden="true"></span>
                <a href="/services" class="@NavClass("services")">Services</a>
                <a href="/projects" class="@NavClass("projects")">Projects</a>
                <a href="/contact" class="btn btn--nav btn--nav-cta primary-nav__cta">Work With Us</a>
            </nav>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell site-footer__upper">
            <div class="site-footer__brand">
                <span class="site-footer__wordmark">OPTIMUM EARTH</span>
                <address class="site-footer__address">
                    Roston House, Plot 56/57<br />
                    P.O Box 200032, Kampala, Uganda<br />
                    <a href="tel:+256784080551">+256 784 080551</a><br />
                    <a href="mailto:uganda@optimum-earth.com">uganda@optimum-earth.com</a>
                </address>
            </div>

            <nav class="site-footer__col" aria-label="Destinations">
                <h3>Destinations</h3>
                <a href="/uganda">Uganda</a>
                <a href="/zambia">Zambia</a>
                <a href="/foundation">Foundation</a>
            </nav>

            <nav class="site-footer__col" aria-label="Services">
                <h3>Services</h3>
                <a href="/services">Water supply</a>
                <a href="/services">GIS &amp; mapping</a>
                <a href="/services">Groundwater monitoring</a>
                <a href="/services">Geothermal consulting</a>
            </nav>

            <nav class="site-footer__col" aria-label="Company">
                <h3>Company</h3>
                <a href="/">Home</a>
                <a href="/projects">Projects</a>
                <a href="/contact">Work With Us</a>
            </nav>
        </div>
        <div class="shell site-footer__lower">
            <span>&copy; @DateTime.Now.Year Optimum Earth. All rights reserved.</span>
            <div class="site-footer__social">
                <a href="https://www.linkedin.com" target="_blank" rel="noopener">LinkedIn</a>
                <a href="https://x.com" target="_blank" rel="noopener">X</a>
                <a href="https://www.facebook.com" target="_blank" rel="noopener">Facebook</a>
            </div>
        </div>
    </footer>

    <button type="button" class="back-to-top" data-back-to-top aria-label="Back to top">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
