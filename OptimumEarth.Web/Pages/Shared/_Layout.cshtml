@{
    // Razor Pages stores the page path (e.g. "/Uganda") in RouteData.Values["page"].
    string current = (ViewContext.RouteData.Values["page"]?.ToString() ?? "").TrimStart('/');
    string NavClass(string pageName) => current.Equals(pageName, StringComparison.OrdinalIgnoreCase) ? "navlink active" : "navlink";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Optimum Earth</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="page-wrap">

        <div class="topbar">
            <div class="left">
                <span>Roston House, Plot 56/57, P.O Box 200032, Kampala, Uganda</span>
                <span>uganda@optimum-earth.com</span>
            </div>
            <div class="social"><span>LinkedIn</span><span>X</span><span>Facebook</span></div>
        </div>

        <div class="mainnav">
            <a asp-page="/Index" class="brand">
                <div class="brand-mark"></div>
                <div class="brand-text">
                    <span class="brand-title">OPTIMUM EARTH</span>
                    <span class="brand-sub">ENGINEERING · ENVIRONMENT</span>
                </div>
            </a>
            <div class="navlinks">
                <a asp-page="/Uganda" class="@NavClass("Uganda")">Uganda</a>
                <a asp-page="/Zambia" class="@NavClass("Zambia")">Zambia</a>
                <a asp-page="/Foundation" class="@NavClass("Foundation")">Foundation</a>
                <span class="navsep"></span>
                <a asp-page="/Services" class="@NavClass("Services")">Services</a>
                <a asp-page="/Projects" class="@NavClass("Projects")">Projects</a>
                <a asp-page="/Contact" class="btn-cta">Work With Us</a>
            </div>
        </div>

        @RenderBody()

        <div class="site-footer">
            <div class="footer-col">
                <div class="footer-brand">OPTIMUM EARTH</div>
                <div class="footer-address">
                    Roston House, Plot 56/57<br />
                    P.O Box 200032, Kampala, Uganda<br />
                    +256 784 080551<br />
                    uganda@optimum-earth.com
                </div>
            </div>
            <div class="footer-col">
                <div class="footer-heading">Destinations</div>
                <a asp-page="/Uganda">Uganda</a>
                <a asp-page="/Zambia">Zambia</a>
                <a asp-page="/Foundation">Foundation</a>
            </div>
            <div class="footer-col">
                <div class="footer-heading">Services</div>
                <a asp-page="/Services">Water supply</a>
                <a asp-page="/Services">GIS &amp; mapping</a>
                <a asp-page="/Services">Groundwater monitoring</a>
                <a asp-page="/Services">Geothermal consulting</a>
            </div>
            <div class="footer-col">
                <div class="footer-heading">Company</div>
                <a asp-page="/Index">Home</a>
                <a asp-page="/Projects">Projects</a>
                <a asp-page="/Contact">Work With Us</a>
            </div>
        </div>

    </div>
</body>
</html>
