@page "/who-we-are"
@model OptimumEarth.Web.Pages.WhoWeAreModel
@{
    ViewData["Theme"] = "who-we-are";
    ViewData["Title"] = "Who We Are";
    ViewData["Description"] = "Optimum Earth has served the East and Southern Africa water and energy industry since 2017, across the full project lifecycle.";
}

<section class="who-we-are" aria-labelledby="who-we-are-heading">
    <div class="who-we-are__rule-row">
        <span class="eyebrow" id="who-we-are-heading" style="letter-spacing:.2em;">Who we are</span>
        <span class="who-we-are__rule" aria-hidden="true"></span>
    </div>

    <div class="who-we-are__split">
        <div class="who-we-are__left">
            <h1 class="who-we-are__statement">Engineering solutions for industry and resilience for communities, across East, Central and Southern Africa since <em>2017</em></h1>

            <div class="who-we-are__mission-vision">
                <div class="mission-vision-item mission-vision-item--vision">
                    <h2 class="mission-vision-item__title">Our Vision</h2>
                    <p class="mission-vision-item__text">@Model.Vision</p>
                </div>

                <div class="mission-vision-item mission-vision-item--mission">
                    <h2 class="mission-vision-item__title">Our Mission</h2>
                    <p class="mission-vision-item__text">@Model.Mission</p>
                </div>
            </div>
        </div>

        <div class="who-we-are__right">
            <div class="who-we-are__support">
                <p class="who-we-are__lede">Optimum Earth began with a friendship, a shared ambition, and a belief that young Africans could build solutions that matter. Founded by four university students from Makerere University in Kampala, Uganda, we've grown into a company committed to practical problem-solving and creating lasting value across Africa.</p>

                <p class="who-we-are__lede">We develop and deliver practical solutions in energy, water, and environmental infrastructure, partnering with communities, businesses, and institutions to tackle the region's most pressing development and sustainability challenges.</p>

                <p class="who-we-are__lede">As Optimum Earth has grown, so has our commitment to the communities and ecosystems we work within. Optimum Earth Foundation (OEF) is our corporate foundation, a not-for-profit arm, created to channel our experience, networks, and resources to the communities that need them most. OEF's work is organized around three pillars - Access, Resilience, and Impact - expanding access to clean water, clean energy, and climate solutions; strengthening the resilience of communities; and bringing partners, knowledge, and finance together to create lasting change across Africa.</p>

                <div class="stat-pair">
                    <div class="stat">
                        <b>100+</b>
                        <span>Organisations served</span>
                    </div>
                    <div class="stat">
                        <b>02</b>
                        <span>Country operations</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="values-section">
        <h2 class="values-section__title">Values</h2>
        <p class="values-section__intro">Across the Optimum Earth Group (Optimum Earth (U) Ltd, Optimum Earth Engineering Ltd and the Optimum Earth Foundation), what we do matters, and so does how we do it. Our core values set the standard for how our staff, associates and volunteers work, the relationships we build with clients, partners and communities, and the difference we seek to make. They are the <b>SCALES</b> we measure ourselves against, and we hold ourselves and one another to them.</p>

        @{
            var scaleItems = Model.Values
                .Select((value, index) => new
                {
                    Value = value,
                    Index = index,
                    Letter = string.IsNullOrWhiteSpace(value.Title) ? string.Empty : value.Title.Trim()[0].ToString().ToUpperInvariant()
                })
                .ToList();
            var firstScaleItem = scaleItems.FirstOrDefault();
        }

        @if (firstScaleItem is not null)
        {
            <div class="values-acronym" aria-label="SCALES values">
                @foreach (var item in scaleItems)
                {
                    <button type="button"
                            class="values-acronym__bubble@(item.Index == 0 ? " is-active" : "")"
                            data-scale-trigger
                            data-scale-title="@item.Value.Title"
                            data-scale-body="@item.Value.Description"
                            aria-pressed="@(item.Index == 0 ? "true" : "false")"
                            aria-label="Show @item.Value.Title">
                        @item.Letter
                    </button>
                }
            </div>

            <div class="values-tooltip" data-scale-panel role="status" aria-live="polite">
                <h3 class="values-tooltip__title" data-scale-panel-title>@firstScaleItem.Value.Title</h3>
                <p class="values-tooltip__body" data-scale-panel-body>@firstScaleItem.Value.Description</p>
            </div>
        }
    </div>

    <div class="capabilities-section">
        <h2 class="capabilities-section__title">Capabilities</h2>
        <div class="capability-grid">
            @foreach (var c in Model.Capabilities)
            {
                <div class="capability-cell">
                    <span class="capability-cell__index">@c.Index</span>
                    <span class="capability-cell__title">@c.Title</span>
                    <span class="capability-cell__desc">@c.Description</span>
                </div>
            }
        </div>
    </div>
</section>
