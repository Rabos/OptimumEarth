@page
@model OptimumEarth.Web.Pages.ZambiaModel
@{
    ViewData["Theme"] = "zambia";
    ViewData["Title"] = "Optimum Earth Zambia — Engineering & Environmental Services";
    ViewData["Description"] = "Optimum Earth Zambia is building regional capability in energy, water, environmental and GIS services across Zambia.";
}

<section class="page-hero">
    <div class="shell page-hero__inner">
        <div class="breadcrumb"><a href="/">Optimum Earth</a> / Zambia</div>
        <span class="eyebrow" style="color:#9FD6C0;">Country operation</span>
        <h1>Optimum Earth Zambia</h1>
        <p>A growing regional operation bringing Optimum Earth's engineering and environmental capability to clients across Zambia.</p>
        <div class="hero__ctas" style="margin-top:24px;">
            <a href="#services" class="btn btn--ghost">Our services</a>
            <a href="#contact" class="btn" style="background:#fff; color:var(--oe-blue-700);">Start a project</a>
        </div>
    </div>
</section>

<section class="section section--white">
    <div class="shell split split--reverse">
        <div>
            <span class="eyebrow">Country overview</span>
            <h2>An expanding regional presence.</h2>
            <p>Zambia is a growing part of the Optimum Earth regional footprint, bringing the same technical disciplines used across the group to local clients and partners as the pipeline of Zambia-based project evidence builds.</p>
            <ul class="check-list">
                <li>Regional engineering and environmental expertise applied locally</li>
                <li>Energy, water and infrastructure capability</li>
                <li>GIS, mapping and remote sensing support</li>
                <li>Growing local partner and regulatory relationships</li>
            </ul>
        </div>
        <div class="split__art" aria-hidden="true">
            <svg viewBox="0 0 400 300"><path d="M0 230c60-50 100 40 160 10s110-80 240-30" stroke="#0D4695" stroke-width="3" fill="none" opacity=".5"/>
                <path d="M0 190c70-40 110 30 170 6s110-60 230-16" stroke="#3E7C59" stroke-width="3" fill="none" opacity=".5"/></svg>
        </div>
    </div>
</section>

<section class="section section--paper" id="services">
    <div class="shell">
        <div class="section-head">
            <span class="eyebrow">Services in Zambia</span>
            <h2>What we deliver locally</h2>
        </div>
        <div class="capability-grid">
            @{
                var services = new (string Title, string Desc, string Icon)[]
                {
                    ("Energy & Infrastructure", "Feasibility, planning and support for energy and related infrastructure.", "M13 2 4 14h7l-1 8 10-13h-7l0-7z"),
                    ("Water Supply Solutions", "Water supply and water resources studies suited to local conditions.", "M12 2s7 8 7 13a7 7 0 1 1-14 0c0-5 7-13 7-13z"),
                    ("Environmental Services", "Environmental screening, assessment and sustainability advisory.", "M12 3c4 3 7 7 7 11a7 7 0 0 1-14 0c0-4 3-8 7-11z"),
                    ("GIS & Mapping", "GIS-related capability to support planning, siting and reporting.", "M3 12h18M12 3v18M5 5l14 14M19 5 5 19"),
                };
            }
            @foreach (var s in services)
            {
                <div class="capability-card" data-reveal>
                    <span class="capability-card__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="@s.Icon"/></svg>
                    </span>
                    <h3>@s.Title</h3>
                    <p>@s.Desc</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="section section--white">
    <div class="shell">
        <div class="section-head">
            <span class="eyebrow">Evidence</span>
            <h2>Projects &amp; pipeline</h2>
            <p>Selected Zambia-based work, with more project evidence added as it becomes available.</p>
        </div>
        <div class="project-grid">
            @foreach (var p in Model.Projects)
            {
                <article class="project-card" data-reveal>
                    <div class="project-card__media"></div>
                    <div class="project-card__body">
                        <div class="project-card__meta">@p.Service</div>
                        <h3>@p.Title</h3>
                        <p style="font-size:.9rem;">Client: @p.Client</p>
                        <div class="project-card__foot"><span>@p.Location</span><span>@p.Year</span></div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section--paper">
    <div class="shell">
        <div class="cta-banner" data-reveal>
            <span class="eyebrow" style="color:#9FD6C0;">Zambia</span>
            <h2>Building in Zambia? Let's talk.</h2>
            <p>Tell us about your project and our regional team will follow up.</p>
            <div class="cta-banner__actions">
                <a href="#contact" class="btn" style="background:#fff; color:var(--oe-blue-700);">Start a conversation</a>
            </div>
        </div>
    </div>
</section>

<section class="section section--white">
    <div class="shell">
        <partial name="_ContactPanel" model="Model.Panel" />
    </div>
</section>
