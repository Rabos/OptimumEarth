@page
@model OptimumEarth.Web.Pages.ErrorModel
@{
    ViewData["Theme"] = "gateway";
    ViewData["Title"] = "Something went wrong";
    ViewData["Robots"] = "noindex, nofollow";
}

<section class="section section--white" style="min-height:50vh; display:flex; align-items:center;">
    <div class="shell" style="text-align:center;">
        <span class="eyebrow" style="justify-content:center;">A System Error</span>
        <h1>Something went wrong.</h1>
        <p>Please try again, or head back to the Optimum Earth gateway.</p>
        <a href="/" class="btn btn--primary">Back to Optimum Earth</a>
    </div>
</section>
