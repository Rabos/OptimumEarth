@page
@model OptimumEarth.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero">
    <div class="hero-img">Hero image</div>
    <div class="hero-scrim"></div>
    <div class="hero-content">
        <div class="eyebrow">One Optimum Earth · Three destinations</div>
        <div class="hero-title">Sustainable infrastructure for East and Southern Africa.</div>
        <div class="hero-sub">Water, energy, environment, GIS and engineering – delivered since 2017 through country operations in Uganda and Zambia, and the Optimum Earth Foundation.</div>
        <div class="hero-actions">
            <a asp-page="/Services" class="btn-primary">Explore Optimum Earth</a>
            <a asp-page="/Contact" class="btn-outline">Work With Us</a>
        </div>
    </div>
</div>

<div class="about-grid">
    <div class="kicker" style="padding-top:8px">Who we are</div>
    <div style="display:flex;flex-direction:column;gap:18px;max-width:840px">
        <div class="about-copy">Optimum Earth has served the East and Southern Africa energy and water industry since 2017 – supporting the full project lifecycle, building partnerships and delivering infrastructure that meets environmental and quality standards.</div>
        <div class="chip-row">
            <span class="chip">Water resources</span>
            <span class="chip">Energy</span>
            <span class="chip">Environment</span>
            <span class="chip">GIS &amp; remote sensing</span>
            <span class="chip">Engineering &amp; construction</span>
        </div>
    </div>
</div>

<div class="section">
    <div class="section-title-row">
        <div style="display:flex;flex-direction:column;gap:10px">
            <div class="kicker">Choose your destination</div>
            <div class="h2" style="font-size:34px">Where would you like to go?</div>
        </div>
        <div class="lead" style="text-align:right">Country operations and our Foundation arm, each with its own services, projects and contacts.</div>
    </div>
    <div class="dest-grid">
        <a asp-page="/Uganda" class="dest-card">
            <div class="dest-img hero-img">Uganda</div>
            <div class="dest-scrim" style="background:linear-gradient(180deg,rgba(26,30,32,.1),rgba(58,74,42,.92))"></div>
            <div class="dest-body">
                <div class="dest-bar" style="background:#5E952E"></div>
                <div class="dest-num">DESTINATION 01</div>
                <div class="dest-title">Uganda</div>
                <div class="dest-desc">Established engineering and environmental services – hydrogeology, boreholes, ESIA, GIS and monitoring.</div>
                <div class="dest-explore">Explore <span class="dest-arrow">→</span></div>
            </div>
        </a>
        <a asp-page="/Zambia" class="dest-card">
            <div class="dest-img hero-img">Zambia</div>
            <div class="dest-scrim" style="background:linear-gradient(180deg,rgba(26,30,32,.1),rgba(33,42,79,.92))"></div>
            <div class="dest-body">
                <div class="dest-bar" style="background:#4E74C8"></div>
                <div class="dest-num">DESTINATION 02</div>
                <div class="dest-title">Zambia</div>
                <div class="dest-desc">Our Southern Africa operation – energy, water, infrastructure and environmental services for the Zambian market.</div>
                <div class="dest-explore">Explore <span class="dest-arrow">→</span></div>
            </div>
        </a>
        <a asp-page="/Foundation" class="dest-card">
            <div class="dest-img hero-img">Foundation</div>
            <div class="dest-scrim" style="background:linear-gradient(180deg,rgba(26,30,32,.1),rgba(42,47,50,.93))"></div>
            <div class="dest-body">
                <div class="dest-bar" style="background:#9CCB6B"></div>
                <div class="dest-num">DESTINATION 03</div>
                <div class="dest-title-serif">The Foundation</div>
                <div class="dest-desc" style="color:rgba(255,255,255,.82)">Community-led development and catalytic philanthropy, organised around Access, Resilience and Impact.</div>
                <div class="dest-explore">Explore <span class="dest-arrow">→</span></div>
            </div>
        </a>
    </div>
</div>

<div class="section section-gray">
    <div class="section-title-row">
        <div class="h2" style="font-size:36px;max-width:520px">What we do across the region</div>
        <a asp-page="/Services" style="font-size:14.5px;font-weight:600">All services →</a>
    </div>
    <div class="card-grid">
        <div class="card"><div class="card-title">Water supply solutions</div><div class="card-desc">Surface and groundwater diagnostics, well troubleshooting and long-term supply planning.</div></div>
        <div class="card"><div class="card-title">Energy &amp; geothermal</div><div class="card-desc">Geothermal consulting and energy infrastructure support across the region.</div></div>
        <div class="card"><div class="card-title">Environment &amp; sustainability</div><div class="card-desc">Impact assessment, monitoring and compliance for major projects.</div></div>
        <div class="card"><div class="card-title">GIS, mapping &amp; remote sensing</div><div class="card-desc">Geo-intelligence products for water, energy and humanitarian decision-making.</div></div>
        <div class="card"><div class="card-title">Mines, oil &amp; gas</div><div class="card-desc">Integrated water management for mineral, metal and aggregate operations.</div></div>
        <a asp-page="/Services" class="card card-dark">
            <div class="card-title">Engineering &amp; construction support</div>
            <div class="card-desc">Full project lifecycle support, from planning to implementation.</div>
        </a>
    </div>
</div>

<div class="section">
    <div class="stat-grid">
        <div><div class="stat-num">2017</div><div class="stat-label">Serving the region since</div></div>
        <div><div class="stat-num">100+</div><div class="stat-label">Organisations served</div></div>
        <div><div class="stat-num">02</div><div class="stat-label">Country operations</div></div>
        <div><div class="stat-num">05</div><div class="stat-label">Core service lines</div></div>
    </div>
    <div class="project-grid">
        @foreach (var p in OptimumEarth.SiteData.AllProjects.Take(3))
        {
            <a asp-page="/Projects" class="project-card">
                <div class="project-thumb">Project photo</div>
                <div class="project-tag">@p.Tag</div>
                <div class="project-title">@p.Title</div>
                <div class="project-meta">@p.Meta</div>
            </a>
        }
    </div>
</div>
