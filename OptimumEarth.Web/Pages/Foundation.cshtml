            {
                var sdg = Model.SdgGoals[i];
                <div class="sdg-loop">
                    <svg class="sdg-loop__ring" viewBox="0 0 320 190" aria-hidden="true">
                        <mask id="sdg-ring-@sdg.Number" maskUnits="userSpaceOnUse">
                            <path d="@(sdgLines[i % sdgLines.Length])" fill="none" stroke="#fff" stroke-width="15" stroke-linecap="round"
                                  stroke-dasharray="@(sdgLens[i % sdgLens.Length])" stroke-dashoffset="@(sdgLens[i % sdgLens.Length])" />
                        </mask>
                        <path d="@(sdgLoops[i % sdgLoops.Length])" />
                        <path class="sdg-loop__ring-draw" d="@(sdgLoops[i % sdgLoops.Length])" mask="url(#sdg-ring-@sdg.Number)" />
                    </svg>
                    <div class="sdg-loop__content">
                        <div class="sdg-loop__icon-wrap">
                            @if (sdg.Number == "06")
                            {
                                <svg class="sdg-loop__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3C12 3 5 11.2 5 15.5 5 19.09 8.13 21 12 21S19 19.09 19 15.5C19 11.2 12 3 12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                            }
                            else if (sdg.Number == "07")
                            {
                                <svg class="sdg-loop__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /></svg>
                            }
                            else if (sdg.Number == "13")
                            {
                                <svg class="sdg-loop__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 18h9.5a3.5 3.5 0 0 0 .5-6.96A5 5 0 0 0 7.28 9.1 4 4 0 0 0 7 18Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                            }
                            else
                            {
                                <svg class="sdg-loop__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="8" width="11" height="8" rx="4" stroke="currentColor" stroke-width="1.6" /><rect x="10" y="8" width="11" height="8" rx="4" stroke="currentColor" stroke-width="1.6" /></svg>
                            }
                            <span class="sdg-loop__num">@sdg.Number</span>
                        </div>
                        <span class="sdg-loop__divider" aria-hidden="true"></span>
                        <span class="sdg-loop__title">@sdg.Label</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="dest-section dest-section--tint" id="pillars" aria-labelledby="pillars-heading">
    <div class="dest-section__head">
        <h2 id="pillars-heading">Our Pillars</h2>
    </div>
    <div class="plain-card-grid">
        @foreach (var pillar in Model.Pillars)
        {
            <article class="pillar-card">
                <h3 class="pillar-card__title">@pillar.Title</h3>
                <p class="pillar-card__desc">@pillar.Description</p>
                <ul class="pillar-card__tags">
                    @foreach (var item in pillar.Items)
                    {
                        <li class="pillar-tag" tabindex="0">
                            <span class="pillar-tag__initial">@item.Substring(0, 1)</span><span class="pillar-tag__rest">@item.Substring(1)</span>
                        </li>
                    }
                </ul>
                <span class="sdg-badge sdg-badge--sm pillar-card__sdg">@pillar.SdgLabel</span>
            </article>
        }
    </div>
</section>

