@page
@model OptimumEarth.Pages.FoundationModel
@{
    ViewData["Title"] = "Foundation";
}

<div class="oef-body">
    <div class="oef-topbar">
        <span>Optimum Earth Foundation · the non-profit arm of Optimum Earth</span>
        <a asp-page="/Index" style="color:#B0B4B6">← Back to Optimum Earth</a>
    </div>
    <div class="oef-subnav">
        <span>About OEF</span><span>What We Do</span><span>Our Approach</span><span>Projects &amp; Stories</span><span>Impact</span><span>Partners</span><span>Get Involved</span>
    </div>

    <div class="oef-hero">
        <div class="oef-hero-copy">
            <div class="oef-eyebrow">ACCESS · RESILIENCE · IMPACT</div>
            <div class="oef-headline">Communities designing the infrastructure they need.</div>
            <div class="oef-sub">The Optimum Earth Foundation channels engineering capability into community-led development – clean water, affordable energy and climate resilience, delivered with partners and measured by results.</div>
            <div style="display:flex;gap:12px;padding-top:6px">
                <span class="btn-oef-solid">Partner with us</span>
                <span class="btn-oef-outline">See our work</span>
            </div>
        </div>
        <div class="oef-hero-img hero-img">Foundation hero image</div>
    </div>

    <div class="oef-pillars">
        <div style="display:flex;flex-direction:column;gap:10px">
            <div class="oef-eyebrow">STRATEGIC PILLARS</div>
            <div class="h2" style="color:#3A3F42">Three pillars, one mandate</div>
        </div>
        <div class="card-grid">
            <div class="pillar-card"><div class="pillar-num">01</div><div class="pillar-title">Access</div><div class="pillar-desc">Clean water, sanitation and affordable energy reaching households and institutions the market has not served.</div></div>
            <div class="pillar-card"><div class="pillar-num">02</div><div class="pillar-title">Resilience</div><div class="pillar-desc">Climate adaptation, water security and systems that keep working through drought, flood and disruption.</div></div>
            <div class="pillar-card"><div class="pillar-num">03</div><div class="pillar-title">Impact</div><div class="pillar-desc">Evidence-informed delivery, measured outcomes and partnerships that mobilise resources where they count.</div></div>
        </div>
    </div>

    <div class="oef-approach">
        <div class="oef-eyebrow" style="padding-top:8px">OUR APPROACH</div>
        <div class="approach-grid">
            <div><div class="approach-title">Community-led</div><div class="approach-desc">Programmes are designed with the communities that will own and maintain them.</div></div>
            <div><div class="approach-title">Evidence-informed</div><div class="approach-desc">Baseline data, monitoring and honest reporting on what worked and what did not.</div></div>
            <div><div class="approach-title">Partnership-driven</div><div class="approach-desc">Government, funders, NGOs and private operators working to one plan.</div></div>
            <div><div class="approach-title">Practical and scalable</div><div class="approach-desc">Solutions engineered to be repeated, not one-off demonstrations.</div></div>
        </div>
    </div>

    <div class="oef-programmes">
        <div class="section-title-row">
            <div class="h2-serif">Programmes &amp; stories</div>
            <span style="font-size:14.5px;font-weight:600;color:#9CCB6B;cursor:pointer">All programmes →</span>
        </div>
        <div class="card-grid">
            <div class="programme-card"><div class="programme-thumb"></div><div class="project-tag" style="color:#9CCB6B">ACCESS</div><div class="project-title" style="color:#fff">Community water points</div><div class="project-meta" style="color:#9DA2A5">Programme description to be confirmed.</div></div>
            <div class="programme-card"><div class="programme-thumb"></div><div class="project-tag" style="color:#9CCB6B">RESILIENCE</div><div class="project-title" style="color:#fff">Climate-smart water security</div><div class="project-meta" style="color:#9DA2A5">Programme description to be confirmed.</div></div>
            <div class="programme-card"><div class="programme-thumb"></div><div class="project-tag" style="color:#9CCB6B">IMPACT</div><div class="project-title" style="color:#fff">Clean energy for institutions</div><div class="project-meta" style="color:#9DA2A5">Programme description to be confirmed.</div></div>
        </div>
    </div>

    <div class="oef-engage">
        <div class="h2" style="color:#3A3F42">Ways to engage</div>
        <div class="engage-grid">
            <div class="engage-card"><div class="approach-title">Partner</div><div class="card-desc">Co-design and co-deliver programmes.</div><div style="font-size:14px;font-weight:600;color:#454A4D;padding-top:6px">Talk to us →</div></div>
            <div class="engage-card"><div class="approach-title">Fund</div><div class="card-desc">Back a programme or a portfolio.</div><div style="font-size:14px;font-weight:600;color:#454A4D;padding-top:6px">Funding options →</div></div>
            <div class="engage-card"><div class="approach-title">Collaborate</div><div class="card-desc">Research, technical and delivery partnerships.</div><div style="font-size:14px;font-weight:600;color:#454A4D;padding-top:6px">Get in touch →</div></div>
            <div class="engage-card"><div class="approach-title">Learn</div><div class="card-desc">Insights, resources and reporting.</div><div style="font-size:14px;font-weight:600;color:#454A4D;padding-top:6px">Read more →</div></div>
        </div>
    </div>
</div>
