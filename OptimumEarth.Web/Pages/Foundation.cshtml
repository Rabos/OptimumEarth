    <div class="principles">
        @for (var i = 0; i < Model.WorkPrinciples.Count; i++)
        {
            var principle = Model.WorkPrinciples[i];
            var ring = i % ringFill.Length;
            var maskId = $"principle-ring-{principle.Slug}";
            <article class="principle">
                <svg class="principle__mark" viewBox="0 0 230 150" aria-hidden="true">
                    <path d="M22 130 C40 64 92 22 182 16 C96 40 56 78 34 132 Z" />
                    <path d="M188 14 C166 20 146 30 130 44 C140 32 150 22 162 14 C150 12 138 12 126 14 C142 6 164 4 188 14 Z" />
                    <path d="M188 14 C182 34 180 54 184 76 C176 60 172 40 174 20 C168 26 162 34 158 42 C162 28 172 18 188 14 Z" />
                </svg>
                <div class="principle__body">
                    <h3 class="principle__title">@principle.Title</h3>
                    <p class="principle__desc">@principle.Description</p>
                    <svg class="principle__ring" viewBox="0 0 400 210" preserveAspectRatio="none" aria-hidden="true">
                        <mask id="@maskId" maskUnits="userSpaceOnUse">
                            <path d="@(ringLine[ring])" fill="none" stroke="#fff" stroke-width="16" stroke-linecap="round"
                                  stroke-dasharray="@(ringLen[ring])" stroke-dashoffset="@(ringLen[ring])" />
                        </mask>
                        <path d="@(ringFill[ring])" mask="url(#@maskId)" />
                    </svg>
                </div>
            </article>
        }
    </div>

</section>

<section class="dest-section dest-section--tint" id="stories" aria-labelledby="stories-heading">
    <div class="dest-section__head">
        <h2 id="stories-heading">Stories &amp; Impact</h2>
        <span class="section-note">Read our stories &middot; Explore our impact</span>
    </div>
    <p class="dest-overview__body" style="max-width:760px;">OEF's story is best told through the people and partners who shape it. We capture our stories and impact through three lenses Communities, Partnerships and Learning each one gathering real voices, projects and evidence as our work takes root and grows.</p>

    @{
        // Communities is held back for now, so the list starts at index 1. The
        // tiles and their galleries both come off this one list so the two
        // cannot drift — previously the tile loop skipped it while the dialog
        // loop did not, leaving a modal nothing could open.
        var visibleStories = Model.StoryTiles.Skip(1).ToList();
    }

    <div class="card-grid card-grid--stories">
        @foreach (var tile in visibleStories)
        {
            <button type="button" class="story-tile" data-story-trigger="@tile.Key" aria-haspopup="dialog">
                <div class="story-tile__media img-slot" role="img" aria-label="@tile.ImageLabel" style="background-image: url('@tile.Cover')"></div>
                <div class="story-tile__body">
                    <h3 class="story-tile__title">@tile.Title</h3>
                    <p class="story-tile__meta">@tile.Summary</p>
                    @* the fuller text, revealed under the hover veil. The dialog this
                       button opens carries the same string, so it is aria-hidden here
                       rather than announced twice. *@
                    <p class="story-tile__full" aria-hidden="true">@tile.ModalBody</p>
                    <span class="story-tile__cue">
                        View gallery
                        <svg viewBox="0 0 20 9" fill="none" aria-hidden="true"><path d="M0 4.5h18M14 1l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </span>
                </div>
            </button>
        }
    </div>

    @foreach (var tile in visibleStories)
    {
        var gallery = Model.Galleries.FirstOrDefault(g => g.Key == tile.Key);
        @* No gallery for this key means nothing to show, so no dialog is emitted
           and site.js leaves the tile inert rather than opening an empty frame. *@
        if (gallery is null || gallery.StoryGalleryItems.Count == 0)
        {
            continue;
        }

        var items = gallery.StoryGalleryItems;

        <dialog class="lightbox" id="story-@tile.Key" aria-labelledby="story-@(tile.Key)-title" data-lightbox>
            <div class="lightbox__panel">
                <header class="lightbox__head">
                    <div>
                        @* <span class="dest-overview__eyebrow">@tile.Title.ToUpperInvariant()</span> *@
                        <h3 id="story-@(tile.Key)-title" class="lightbox__title">@tile.Title</h3>
                    </div>
                    <p class="lightbox__count"><span data-lightbox-position>1</span> / @items.Count</p>
                    <button type="button" class="lightbox__close" data-story-close aria-label="Close gallery">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                    </button>
                </header>

                <div class="lightbox__stage">
                    <button type="button" class="lightbox__nav lightbox__nav--prev" data-lightbox-prev aria-label="Previous image">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 4L7 12l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>

                    <div class="lightbox__frame">
                        @for (var j = 0; j < items.Count; j++)
                        {
                            var item = items[j];
                            <figure class="lightbox__slide @(j == 0 ? "is-current" : "")" data-lightbox-slide>
                                @* lazy so a closed dialog costs nothing; these are still
                                   the full-size originals, several megabytes each *@
                                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" decoding="async" />
                            </figure>
                        }
                    </div>

                    <button type="button" class="lightbox__nav lightbox__nav--next" data-lightbox-next aria-label="Next image">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 4l8 8-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                </div>

                <p class="lightbox__caption" data-lightbox-caption>@items[0].Title</p>

                <ul class="lightbox__thumbs">
                    @for (var j = 0; j < items.Count; j++)
                    {
                        var item = items[j];
                        <li>
                            <button type="button" class="lightbox__thumb @(j == 0 ? "is-current" : "")"
                                    data-lightbox-thumb style="background-image: url('@item.ImageUrl')"
                                    aria-label="Show @item.Title"></button>
                        </li>
                    }
                </ul>
            </div>
        </dialog>
    }
</section>

<section class="dest-cta" aria-labelledby="cta-heading" id="connect">
    <div>
        <h2 class="dest-cta__title" id="cta-heading">Connect With Us</h2>
        <p class="dest-cta__body">Partner, fund or collaborate. Tell us which and we will route your enquiry to the right programme lead full contact details and social links are in the footer below.</p>
    </div>
    <div>
        @if (Model.Submitted)
        {
            <p class="form-success" role="status">Thank you:- your enquiry is in. Our team will be in touch shortly.</p>
        }
        else
        {
            <form class="mini-form" method="post" asp-page-handler="Quick">
                <div asp-validation-summary="ModelOnly" class="visually-hidden" role="alert"></div>
                <input type="hidden" asp-for="Quick.Destination" />
                <div class="mini-form__row">
                    <div>
                        <label class="visually-hidden" asp-for="Quick.FullName">Full name</label>
                        <input asp-for="Quick.FullName" placeholder="Full name" autocomplete="name" />
                        <span asp-validation-for="Quick.FullName" class="field-error"></span>
                    </div>
                    <div>
                        <label class="visually-hidden" asp-for="Quick.Email">Email</label>
                        <input asp-for="Quick.Email" type="email" placeholder="Email" autocomplete="email" />
                        <span asp-validation-for="Quick.Email" class="field-error"></span>
                    </div>
                </div>
                <div>
                    <label class="visually-hidden" asp-for="Quick.Service">How would you like to engage?</label>
                    <select asp-for="Quick.Service">
                        <option value="">How would you like to engage?</option>
                        @foreach (var option in OptimumEarth.Web.Pages.FoundationModel.EngagementOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span asp-validation-for="Quick.Service" class="field-error"></span>
                </div>
                <button type="submit" class="mini-form__submit">Send enquiry</button>
            </form>
        }
    </div>
</section>
