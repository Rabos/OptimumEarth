@page
@model OptimumEarth.Web.Pages.FoundationModel
@{
    ViewData["Theme"] = "foundation";
    ViewData["Title"] = "Optimum Earth Foundation - Access, Resilience, Impact";
    ViewData["Description"] = "The Optimum Earth Foundation is the community-led, non-profit arm of Optimum Earth, focused on Access, Resilience and Impact across water, energy and climate.";
}

<div class="dest-hero">
    <div class="img-slot" role="img" aria-label="Foundation community photo" style="background-image: url('/img/optimum-earth-images/foundation1.jpg')"></div>
    <div class="dest-hero__scrim" aria-hidden="true"></div>
    <div class="dest-hero__copy">
        @* <span class="dest-hero__eyebrow">OPTIMUM EARTH FOUNDATION</span> *@
        <h1 class="dest-hero__headline">Building resilient communities with access to practical climate solutions.</h1>
        <p class="dest-hero__sub">A corporate foundation connecting community priorities with the partnerships, knowledge and resources needed to turn practical ideas into lasting impact.</p>
    </div>
</div>

<nav class="sub-nav" data-sub-nav aria-label="Foundation page sections">
    <a href="#about" class="sub-nav__link" data-sub-nav-link="about">About</a>
    <a href="#pillars" class="sub-nav__link" data-sub-nav-link="pillars">Pillars</a>
    <a href="#how-we-work" class="sub-nav__link" data-sub-nav-link="how-we-work">How We Work</a>
    <a href="#stories" class="sub-nav__link" data-sub-nav-link="stories">Stories &amp; Impact</a>
    <a href="#connect" class="sub-nav__link" data-sub-nav-link="connect">Connect</a>
</nav>

<section class="dest-overview" id="about" aria-labelledby="about-heading">
    <div class="dest-overview__main">
        <span class="dest-overview__eyebrow" id="about-heading">ABOUT OEF</span>
        <p class="dest-overview__quote dest-overview__quote--intro">Optimum Earth Foundation (OEF) is a corporate foundation; a not-for-profit initiative focused on practical solutions that expand access to clean water, clean energy and climate solutions while strengthening community resilience. OEF connects community priorities with the partnerships, knowledge and resources needed to turn practical ideas into lasting impact.</p>
        <p class="dest-overview__body dest-overview__body--intro">OEF was established as the not-for-profit arm of Optimum Earth Limited, building on the company's experience in energy, water and environmental infrastructure across East and Southern Africa. The Foundation operates as a distinct not-for-profit entity with its own governance, strategy and financing.</p>
    </div>
    <aside class="glance-panel" aria-label="At a glance">
        <span class="glance-panel__title">At a glance</span>
        <div class="glance-row"><span class="glance-row__key">Mandate</span><span class="glance-row__value">Non-profit arm of Optimum Earth Limited</span></div>
        <div class="glance-row"><span class="glance-row__key">Governance</span><span class="glance-row__value">Advisory Board-led</span></div>
        <div class="glance-row"><span class="glance-row__key">Pillars</span><span class="glance-row__value">Access &middot; Resilience &middot; Impact</span></div>
        <div class="glance-row"><span class="glance-row__key">Geographic focus</span><span class="glance-row__value">Uganda &middot; Zambia</span></div>
    </aside>
    <div class="vm-grid">
        <div class="vm-card vm-card--vision">
            <div class="vm-card__head">
                <svg class="vm-card__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                <span class="vm-card__label">Our Vision</span>
            </div>
            <p class="vm-card__text">Resilient and sustainable communities with access to water, clean energy, climate solutions and inclusive systems.</p>
        </div>
        <div class="vm-card vm-card--mission">
            <div class="vm-card__head">
                <svg class="vm-card__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" /><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5" /><circle cx="12" cy="12" r="1.5" fill="currentColor" /></svg>
                <span class="vm-card__label">Our Mission</span>
            </div>
            <p class="vm-card__text">To catalyse and scale inclusive, community-driven solutions that expand access to water, clean energy, and climate resilience through strategic partnerships, local capacity building, and innovative financing.</p>
        </div>
    </div>
    <div class="dest-overview__full">
        <span class="dest-overview__eyebrow">SDG ALIGNMENT</span>
        <div class="sdg-leaves">
            @foreach (var sdg in Model.SdgGoals)
            {
                <div class="sdg-leaf">
                    <svg class="sdg-leaf__shape" viewBox="0 0 32 32" preserveAspectRatio="none" aria-hidden="true">
                        <path d="M16 2 C16 2 4 15 4 22 C4 27.523 9.477 30 16 30 C22.523 30 28 27.523 28 22 C28 15 16 2 16 2 Z" transform="rotate(90 16 16)" />
                    </svg>
                    <div class="sdg-leaf__content">
                        <div class="sdg-leaf__icon-wrap">
                            @if (sdg.Number == "06")
                            {
                                <svg class="sdg-leaf__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3C12 3 5 11.2 5 15.5 5 19.09 8.13 21 12 21S19 19.09 19 15.5C19 11.2 12 3 12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                            }
                            else if (sdg.Number == "07")
                            {
                                <svg class="sdg-leaf__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" /></svg>
                            }
                            else if (sdg.Number == "13")
                            {
                                <svg class="sdg-leaf__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 18h9.5a3.5 3.5 0 0 0 .5-6.96A5 5 0 0 0 7.28 9.1 4 4 0 0 0 7 18Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
                            }
                            else
                            {
                                <svg class="sdg-leaf__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="8" width="11" height="8" rx="4" stroke="currentColor" stroke-width="1.6" /><rect x="10" y="8" width="11" height="8" rx="4" stroke="currentColor" stroke-width="1.6" /></svg>
                            }
                            <span class="sdg-leaf__num">@sdg.Number</span>
                        </div>
                        <span class="sdg-leaf__divider" aria-hidden="true"></span>
                        <span class="sdg-leaf__title">@sdg.Label</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="dest-section dest-section--tint" id="pillars" aria-labelledby="pillars-heading">
    <div class="dest-section__head">
        <h2 id="pillars-heading">Our Pillars</h2>
    </div>
    <div class="plain-card-grid">
        @foreach (var pillar in Model.Pillars)
        {
            <article class="pillar-card">
                <h3 class="pillar-card__title">@pillar.Title</h3>
                <p class="pillar-card__desc">@pillar.Description</p>
                <ul class="pillar-card__tags">
                    @foreach (var item in pillar.Items)
                    {
                        <li class="pillar-tag" tabindex="0">
                            <span class="pillar-tag__initial">@item.Substring(0, 1)</span><span class="pillar-tag__rest">@item.Substring(1)</span>
                        </li>
                    }
                </ul>
                <span class="sdg-badge sdg-badge--sm pillar-card__sdg">@pillar.SdgLabel</span>
            </article>
        }
    </div>
</section>

<section class="dest-section" id="how-we-work" aria-labelledby="how-we-work-heading">
    <div class="dest-section__head">
        <h2 id="how-we-work-heading">How We Work</h2>
    </div>
    <div class="plain-card-grid">
        @foreach (var principle in Model.WorkPrinciples)
        {
            <article class="service-card @principle.Slug">
                <h3 class="service-card__title">@principle.Title</h3>
                <p class="service-card__desc">@principle.Description</p>
            </article>
        }
    </div>

</section>

<section class="dest-section dest-section--tint" id="stories" aria-labelledby="stories-heading">
    <div class="dest-section__head">
        <h2 id="stories-heading">Stories &amp; Impact</h2>
        <span class="section-note">Read our stories &middot; Explore our impact</span>
    </div>
    <p class="dest-overview__body" style="max-width:760px;">OEF's story is best told through the people and partners who shape it. We capture our stories and impact through three lenses Communities, Partnerships and Learning each one gathering real voices, projects and evidence as our work takes root and grows.</p>

    <div class="card-grid">
        @for (var i = 1; i < Model.StoryTiles.Count; i++)
        {
            var tile = Model.StoryTiles[i];
            <button type="button" class="story-tile" data-story-trigger="@tile.Key" aria-haspopup="dialog">
                <div class="project-card__media img-slot" role="img" aria-label="@tile.ImageLabel" style="background-image: url('/img/optimum-earth-images/foundation@(i + 1).jpg')"></div>
                <div class="project-card__body">
                    <h3 class="project-card__title">@tile.Title</h3>
                    <p class="project-card__meta">@tile.Summary</p>
                </div>
            </button>
        }
    </div>

    @foreach (var tile in Model.StoryTiles)
    {
        <dialog class="story-modal" id="story-@tile.Key" aria-labelledby="story-@(tile.Key)-title">
            <div class="story-modal__panel">
                <button type="button" class="story-modal__close" data-story-close aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
                <span class="dest-overview__eyebrow">@tile.Title.ToUpperInvariant()</span>
                <h3 id="story-@(tile.Key)-title" class="story-modal__title">@tile.Title</h3>
                <p class="story-modal__body">@tile.ModalBody</p>
            </div>
        </dialog>
    }
</section>

<section class="dest-cta" aria-labelledby="cta-heading" id="connect">
    <div>
        <h2 class="dest-cta__title" id="cta-heading">Connect With Us</h2>
        <p class="dest-cta__body">Partner, fund or collaborate. Tell us which and we will route your enquiry to the right programme lead full contact details and social links are in the footer below.</p>
    </div>
    <div>
        @if (Model.Submitted)
        {
            <p class="form-success" role="status">Thank you:- your enquiry is in. Our team will be in touch shortly.</p>
        }
        else
        {
            <form class="mini-form" method="post" asp-page-handler="Quick">
                <div asp-validation-summary="ModelOnly" class="visually-hidden" role="alert"></div>
                <input type="hidden" asp-for="Quick.Destination" />
                <div class="mini-form__row">
                    <div>
                        <label class="visually-hidden" asp-for="Quick.FullName">Full name</label>
                        <input asp-for="Quick.FullName" placeholder="Full name" autocomplete="name" />
                        <span asp-validation-for="Quick.FullName" class="field-error"></span>
                    </div>
                    <div>
                        <label class="visually-hidden" asp-for="Quick.Email">Email</label>
                        <input asp-for="Quick.Email" type="email" placeholder="Email" autocomplete="email" />
                        <span asp-validation-for="Quick.Email" class="field-error"></span>
                    </div>
                </div>
                <div>
                    <label class="visually-hidden" asp-for="Quick.Service">How would you like to engage?</label>
                    <select asp-for="Quick.Service">
                        <option value="">How would you like to engage?</option>
                        @foreach (var option in OptimumEarth.Web.Pages.FoundationModel.EngagementOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                    <span asp-validation-for="Quick.Service" class="field-error"></span>
                </div>
                <button type="submit" class="mini-form__submit">Send enquiry</button>
            </form>
        }
    </div>
</section>
