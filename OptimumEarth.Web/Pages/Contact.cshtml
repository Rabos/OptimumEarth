@page
@model OptimumEarth.Web.Pages.ContactModel
@{
    ViewData["Theme"] = "contact";
    ViewData["Title"] = "Contact Us — Work With Optimum Earth";
    ViewData["Description"] = "Get in touch with Optimum Earth Uganda, Optimum Earth Zambia or the Optimum Earth Foundation. We reply within two working days.";
}

<div class="contact-grid">
    <section class="contact-panel-left">
        <div class="contact-panel-left__intro">
            <span class="eyebrow" style="letter-spacing:.16em;">Work with us</span>
            <h1 class="contact-panel-left__title">Tell us what you need and where.</h1>
            <p class="contact-panel-left__lede">Pick your route below – we will send the enquiry to the Uganda team, the Zambia team or the Foundation and reply within two working days.</p>
        </div>

        @if (Model.Submitted)
        {
            <p class="success-banner" role="status">Thank you — your enquiry is in. A member of the team will be in touch within two working days.</p>
        }

        <form class="contact-form" method="post">
            <div asp-validation-summary="ModelOnly" class="visually-hidden" role="alert"></div>

            <fieldset style="border:0; padding:0; margin:0;">
                <legend class="visually-hidden">I am getting in touch as</legend>
                <div class="role-chips">
                    @{
                        var roleLabels = new Dictionary<string, string>
                        {
                            ["Client"] = "I'm a client",
                            ["Partner"] = "I'm a partner",
                            ["Foundation supporter"] = "Foundation supporter",
                        };
                    }
                    @foreach (var audience in OptimumEarth.Web.Pages.ContactModel.Audiences)
                    {
                        var id = "audience-" + audience.Replace(" ", "-").ToLowerInvariant();
                        <div class="role-chip">
                            <input type="radio" asp-for="Contact.Audience" value="@audience" id="@id" />
                            <label for="@id">@roleLabels[audience]</label>
                        </div>
                    }
                </div>
            </fieldset>

            <div class="contact-form__row">
                <div class="contact-form__field">
                    <label asp-for="Contact.FullName">Full name</label>
                    <input asp-for="Contact.FullName" autocomplete="name" placeholder="Jane Doe" />
                    <span asp-validation-for="Contact.FullName" class="field-error" style="color:#B3261E;"></span>
                </div>
                <div class="contact-form__field">
                    <label asp-for="Contact.Organisation">Organisation</label>
                    <input asp-for="Contact.Organisation" autocomplete="organization" placeholder="Company or institution" />
                </div>
                <div class="contact-form__field">
                    <label asp-for="Contact.Email">Email</label>
                    <input asp-for="Contact.Email" type="email" autocomplete="email" placeholder="jane@example.com" />
                    <span asp-validation-for="Contact.Email" class="field-error" style="color:#B3261E;"></span>
                </div>
                <div class="contact-form__field">
                    <label asp-for="Contact.Phone">Phone</label>
                    <input asp-for="Contact.Phone" type="tel" autocomplete="tel" placeholder="+256 …" />
                    <span asp-validation-for="Contact.Phone" class="field-error" style="color:#B3261E;"></span>
                </div>
                <div class="contact-form__field">
                    <label asp-for="Contact.Country">Country</label>
                    <select asp-for="Contact.Country">
                        <option value="">Choose one</option>
                        @foreach (var country in OptimumEarth.Web.Pages.ContactModel.Countries)
                        {
                            <option value="@country">@country</option>
                        }
                    </select>
                    <span asp-validation-for="Contact.Country" class="field-error" style="color:#B3261E;"></span>
                </div>
                <div class="contact-form__field">
                    <label asp-for="Contact.Service">Service</label>
                    <select asp-for="Contact.Service">
                        <option value="">Choose one</option>
                        @foreach (var service in OptimumEarth.Web.Pages.ContactModel.ServiceOptions)
                        {
                            <option value="@service">@service</option>
                        }
                    </select>
                    <span asp-validation-for="Contact.Service" class="field-error" style="color:#B3261E;"></span>
                </div>
                <div class="contact-form__field contact-form__field--full">
                    <label asp-for="Contact.Message">How can we help?</label>
                    <textarea asp-for="Contact.Message" placeholder="Describe the site, scope or timeline …"></textarea>
                    <span asp-validation-for="Contact.Message" class="field-error" style="color:#B3261E;"></span>
                </div>
            </div>

            <button type="submit" class="contact-form__submit">Send enquiry</button>
        </form>
    </section>

    <section class="contact-panel-right" aria-label="Regional contacts">
        <div class="contact-panel-right__media img-slot" role="img" aria-label="Map or office photo"></div>

        <div class="contact-info">
            <h2 class="contact-info__label">REGIONAL CONTACTS</h2>

            <div class="contact-office">
                <h3 class="contact-office__name">Optimum Earth Uganda</h3>
                <p class="contact-office__detail">
                    Roston House, Plot 56/57, P.O Box 200032, Kampala<br />
                    <a href="tel:+256784080551">+256 784 080551</a> / <a href="tel:+256751584035">+256 751 584035</a><br />
                    <a href="mailto:uganda@optimum-earth.com">uganda@optimum-earth.com</a>
                </p>
            </div>

            <div class="contact-office">
                <h3 class="contact-office__name">Optimum Earth Zambia</h3>
                <p class="contact-office__detail">
                    Office address to be confirmed<br />
                    <a href="mailto:zambia@optimum-earth.com">zambia@optimum-earth.com</a>
                </p>
            </div>

            <div class="contact-office">
                <h3 class="contact-office__name">Optimum Earth Foundation</h3>
                <p class="contact-office__detail">
                    Partner &middot; Fund &middot; Collaborate<br />
                    <a href="mailto:foundation@optimum-earth.com">foundation@optimum-earth.com</a>
                </p>
            </div>
        </div>

        <div class="contact-hours">
            <h2 class="contact-hours__title">Office hours</h2>
            <p class="contact-hours__body">Monday – Friday, 9am – 5pm EAT<br />No soliciting</p>
        </div>
    </section>
</div>
