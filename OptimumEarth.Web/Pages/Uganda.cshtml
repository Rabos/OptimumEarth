@page
@model OptimumEarth.Web.Pages.UgandaModel
@{
    ViewData["Theme"] = "uganda";
    ViewData["Title"] = "Optimum Earth Uganda — Engineering & Environmental Services";
    ViewData["Description"] = "Optimum Earth Uganda delivers water supply, energy, environmental, GIS and engineering solutions across Uganda.";
}

<section class="page-hero">
    <div class="shell page-hero__inner">
        <div class="breadcrumb"><a href="/">Optimum Earth</a> / Uganda</div>
        <span class="eyebrow" style="color:#9FD6C0;">Country operation</span>
        <h1>Optimum Earth Uganda</h1>
        <p>Established engineering and environmental capability, delivered by a team based in Uganda for clients across the country.</p>
        <div class="hero__ctas" style="margin-top:24px;">
            <a href="#services" class="btn btn--ghost">Our services</a>
            <a href="#contact" class="btn" style="background:#fff; color:var(--oe-blue-700);">Start a project</a>
        </div>
    </div>
</section>

<section class="section section--white">
    <div class="shell split">
        <div class="split__art" aria-hidden="true">
            <svg viewBox="0 0 400 300"><path d="M0 230c60-50 100 40 160 10s110-80 240-30" stroke="#0D4695" stroke-width="3" fill="none" opacity=".5"/>
                <path d="M0 190c70-40 110 30 170 6s110-60 230-16" stroke="#3E7C59" stroke-width="3" fill="none" opacity=".5"/></svg>
        </div>
        <div>
            <span class="eyebrow">Country overview</span>
            <h2>Established presence, trusted delivery.</h2>
            <p>Optimum Earth has built a track record in Uganda since 2017, working with government, development partners and private clients on water, environment, GIS and engineering projects nationwide.</p>
            <ul class="check-list">
                <li>Locally based engineers and environmental specialists</li>
                <li>Experience across water supply, energy and infrastructure</li>
                <li>GIS, mapping and remote sensing capability</li>
                <li>Track record with government and development partners</li>
            </ul>
        </div>
    </div>
</section>

<section class="section section--paper" id="services">
    <div class="shell">
        <div class="section-head">
            <span class="eyebrow">Services in Uganda</span>
            <h2>What we deliver locally</h2>
        </div>
        <div class="capability-grid">
            @{
                var services = new (string Title, string Desc, string Icon)[]
                {
                    ("Water Supply Solutions", "Design, supervision and delivery of water supply schemes and water resources studies.", "M12 2s7 8 7 13a7 7 0 1 1-14 0c0-5 7-13 7-13z"),
                    ("Environmental Services", "Environmental and social impact assessments, monitoring and sustainability advisory.", "M12 3c4 3 7 7 7 11a7 7 0 0 1-14 0c0-4 3-8 7-11z"),
                    ("GIS & Mapping", "GIS, mapping and remote sensing to support planning, monitoring and reporting.", "M3 12h18M12 3v18M5 5l14 14M19 5 5 19"),
                    ("Engineering & Infrastructure", "Engineering design, construction supervision and infrastructure support.", "M3 21h18M5 21V10l7-6 7 6v11M9 21v-6h6v6"),
                };
            }
            @foreach (var s in services)
            {
                <div class="capability-card" data-reveal>
                    <span class="capability-card__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="@s.Icon"/></svg>
                    </span>
                    <h3>@s.Title</h3>
                    <p>@s.Desc</p>
                </div>
            }
        </div>
    </div>
</section>

<section class="section section--white">
    <div class="shell">
        <div class="section-head">
            <span class="eyebrow">Evidence</span>
            <h2>Featured projects</h2>
            <p>A selection of Uganda-based project work across our core disciplines.</p>
        </div>
        <div class="project-grid">
            @foreach (var p in Model.Projects)
            {
                <article class="project-card" data-reveal>
                    <div class="project-card__media"></div>
                    <div class="project-card__body">
                        <div class="project-card__meta">@p.Service</div>
                        <h3>@p.Title</h3>
                        <p style="font-size:.9rem;">Client: @p.Client</p>
                        <div class="project-card__foot"><span>@p.Location</span><span>@p.Year</span></div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section--paper">
    <div class="shell">
        <div class="cta-banner" data-reveal>
            <span class="eyebrow" style="color:#9FD6C0;">Uganda</span>
            <h2>Have a project in mind?</h2>
            <p>Send us the brief and our Uganda team will come back with next steps.</p>
            <div class="cta-banner__actions">
                <a href="#contact" class="btn" style="background:#fff; color:var(--oe-blue-700);">Start a conversation</a>
            </div>
        </div>
    </div>
</section>

<section class="section section--white">
    <div class="shell">
        <partial name="_ContactPanel" model="Model.Panel" />
    </div>
</section>
