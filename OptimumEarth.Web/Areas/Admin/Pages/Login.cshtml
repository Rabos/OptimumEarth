@page "/admin/login"
@model LoginModel
@{
    Layout = "_BareLayout";
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>
@if (TempData["Flash"] is string flash)
{
    <div class="flash" role="status">@flash</div>
}
<form method="post" class="formcard" novalidate style="max-width:none">
    @if (Model.Error is not null)
    {
        <div class="flash flash--error" role="alert">@Model.Error</div>
    }
    <div class="fgrid" style="grid-template-columns:1fr">
        <label class="fld"><span class="fl">Email</span>
            <input asp-for="Input.Email" type="email" autocomplete="username" autofocus />
            <span asp-validation-for="Input.Email" class="err"></span>
        </label>
        <label class="fld"><span class="fl">Password</span>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="err"></span>
        </label>
    </div>
    <p class="hint" style="margin:10px 0 14px">After 5 failed attempts an account is locked for 15 minutes.</p>
    <button type="submit" class="btn btn--pri" style="width:100%">Sign in</button>
</form>
