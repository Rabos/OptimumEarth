@{
    var title = ViewData["Title"] as string ?? "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@title - Optimum Earth Content Studio</title>
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin admin--bare">
<main class="bare">
    <div class="lbox">
        <div class="brand brand--dark"><img src="~/img/logo-icon.png" alt="" width="28" height="28" /><span>Optimum Earth<small>Content studio</small></span></div>
        @RenderBody()
    </div>
</main>
<script src="~/js/admin.js" asp-append-version="true"></script>
</body>
</html>
