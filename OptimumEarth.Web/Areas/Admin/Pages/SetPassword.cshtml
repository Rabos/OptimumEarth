@page "/admin/set-password"
@model SetPasswordModel
@{
    Layout = "_BareLayout";
    ViewData["Title"] = "Set your password";
}

<h1>Set your password</h1>
@if (Model.Error is not null)
{
    <div class="flash flash--error" role="alert">@Model.Error</div>
}
@if (Model.PersonName is not null)
{
    <p class="hint">Welcome, @Model.PersonName. Choose a password of at least 12 characters.</p>
    <form method="post" novalidate>
        <input type="hidden" asp-for="Uid" />
        <input type="hidden" asp-for="Token" />
        <div class="fgrid" style="grid-template-columns:1fr">
            <label class="fld"><span class="fl">New password</span>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" autofocus />
                <span asp-validation-for="Input.Password" class="err"></span>
            </label>
            <label class="fld"><span class="fl">Repeat password</span>
                <input asp-for="Input.Confirm" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Confirm" class="err"></span>
            </label>
        </div>
        <p style="margin-top:14px"><button type="submit" class="btn btn--pri" style="width:100%">Set password</button></p>
    </form>
}
